# Public market data does not require exchange API keys.
EXCHANGE_ID=binanceusdm
MARKET_TYPE=swap

# The scanner fetches one entry timeframe and one higher trend timeframe.
ENTRY_TIMEFRAME=5m
TREND_TIMEFRAME=4h
OHLCV_LIMIT=200
MAX_CONCURRENCY=8
FRVP_LOOKBACK_BARS=96
FRVP_ROWS=48
FRVP_VALUE_AREA_PERCENT=0.70

# Scans begin immediately and repeat every 30 seconds.
SCAN_INTERVAL_SECONDS=30
MIN_SIGNAL_SCORE=65
MIN_VOLUME_RATIO=1.0
MAX_LONG_RSI=70
MIN_SHORT_RSI=30
BREAKOUT_VOLUME_RATIO=1.5
MAX_ENTRY_DRIFT_ATR=0.25

# Telegram is optional. Alerts are deduplicated per completed entry candle.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
